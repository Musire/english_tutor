{
  "name": "repisas-flotantes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "host": "vite --host",
    "dev:clear": "clear && vite",
    "clean": "rd /s /q .next && npm run dev:clear",
    "nuke": "rd /s /q .next node_modules && del /f /q package-lock.json && npm install",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@generouted/react-router": "^1.20.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router": "^7.18.1",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pages": "^0.33.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.1",
    "vite-imagetools": "^10.0.1",
    "vite-plugin-image-optimizer": "^2.0.3"
  }
}
